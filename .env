# ==============================================================================
# NEXUS — THE LAST CHANCE (Cyber Quest)
# Root Environment Variables (Local Development & Docker Compose)
# ==============================================================================

NODE_ENV=development
PORT=5050
CLIENT_PORT=5173
MONGO_PORT=27017

# Local / Atlas MongoDB URI
MONGO_URI=mongodb+srv://atharvas7153_db_user:4VnzrL4iVyswdZEh@test.fmbuqw6.mongodb.net

# Docker Internal Network MongoDB URI (used by `server` container inside docker-compose)
# Set to mongodb://mongodb:27017/nexus for local Docker MongoDB, or your Atlas URI if preferred
DOCKER_MONGO_URI=mongodb://mongodb:27017/nexus

# Docker Multi-Stage Build Target (production | development)
DOCKER_BUILD_TARGET=production
# Mode Toggle: set TESTING=true to switch from localhost to Cloudflare Tunnel URLs
TESTING=false

# Frontend & Socket Endpoints — Localhost (used when TESTING=false)
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5050
VITE_API_BASE_URL=http://localhost:5050
VITE_SOCKET_URL=http://localhost:5050x  

# Cloudflare Tunnel Endpoints (used when TESTING=true)
CLOUDFLARE_URL=https://your-tunnel.trycloudflare.com
CLOUDFLARE_CLIENT_URL=https://your-client-tunnel.trycloudflare.com
CLOUDFLARE_API_URL=https://your-api-tunnel.trycloudflare.com
CLOUDFLARE_SOCKET_URL=https://your-api-tunnel.trycloudflare.com
VITE_CLOUDFLARE_URL=https://your-api-tunnel.trycloudflare.com

# JWT Authentication & Role Isolation Secrets
JWT_SECRET=nexus_core_authoritative_secret_key_2026
JWT_EXPIRES_IN=8h

# Configurable Resistance Credits Economy Parameters
STARTING_CREDITS=1250
CREDIT_COST_HINT=100
CREDIT_COST_EXTRA_TIME=150
CREDIT_REATTEMPT_MULTIPLIER=1.25

# System Telemetry Metadata
SYSTEM_DESIGNATION=NEXUS-CORE-01
SYSTEM_VERSION=1.0.0-NEXUS-FINAL
