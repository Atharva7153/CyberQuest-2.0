# ==============================================================================
# NEXUS — THE LAST CHANCE (Cyber Quest)
# Root Environment Variables Template (Local Development & Docker Compose)
# ==============================================================================

# Runtime Environment (development | production)
NODE_ENV=development

# Backend Server Port
PORT=5050

# Frontend Client Port (Docker host port mapping)
CLIENT_PORT=5173

# MongoDB Host Port Mapping (used by MongoDB Compass GUI on host machine)
MONGO_PORT=27017

# Local Development MongoDB URI (connects to local mongod or exposed Docker MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/nexus

# Docker Internal Network MongoDB URI (used by `server` container inside docker-compose)
DOCKER_MONGO_URI=mongodb://mongodb:27017/nexus

# Docker Multi-Stage Build Target (production | development)
DOCKER_BUILD_TARGET=production

# Frontend & Socket Endpoints
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5050
VITE_API_BASE_URL=http://localhost:5050
VITE_SOCKET_URL=http://localhost:5050

# JWT Authentication & Role Isolation Secrets
JWT_SECRET=nexus_core_authoritative_secret_key_2026
JWT_EXPIRES_IN=8h

# Configurable Resistance Credits Economy Parameters
STARTING_CREDITS=1250
CREDIT_COST_HINT=100
CREDIT_COST_EXTRA_TIME=150
CREDIT_REATTEMPT_MULTIPLIER=1.25

# System Telemetry Metadata
SYSTEM_DESIGNATION=NEXUS-CORE-01
SYSTEM_VERSION=1.0.0-NEXUS-FINAL
