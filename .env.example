# ==========================================
# NEXUS — THE LAST CHANCE (PHASE 2 INFRA)
# Root Environment Template (Local & Docker)
# ==========================================

NODE_ENV=development
PORT=5050

# Local MongoDB URI (for Docker Compose, docker-compose.yml defaults to mongodb://mongodb:27017/nexus)
MONGO_URI=mongodb://127.0.0.1:27017/nexus

# Frontend & Socket Endpoints
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5050
