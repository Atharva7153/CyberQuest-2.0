# ==============================================================================
# NEXUS — THE LAST CHANCE (Cyber Quest)
# Root .dockerignore
# ==============================================================================

# Node dependencies
node_modules
client/node_modules
server/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist
client/dist
build
coverage

# Environment files (never bake real secrets into Docker layers)
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# Version control & OS metadata
.git
.gitignore
.DS_Store
Thumbs.db
*.log
*.tar
*.tar.gz
.vscode
.idea
