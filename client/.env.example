# Set TESTING=true to use Cloudflare Tunnel URLs instead of localhost
TESTING=false

# Localhost URLs (used when TESTING=false)
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5050
VITE_API_BASE_URL=http://localhost:5050
VITE_SOCKET_URL=http://localhost:5050
DOCKER_API_TARGET=http://localhost:5050

# Cloudflare Tunnel URLs (used when TESTING=true)
CLOUDFLARE_URL=https://your-tunnel.trycloudflare.com
CLOUDFLARE_CLIENT_URL=https://your-client-tunnel.trycloudflare.com
CLOUDFLARE_API_URL=https://your-api-tunnel.trycloudflare.com
CLOUDFLARE_SOCKET_URL=https://your-api-tunnel.trycloudflare.com
VITE_CLOUDFLARE_URL=https://your-api-tunnel.trycloudflare.com
